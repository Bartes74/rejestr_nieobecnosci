{
  "name": "@nieobecnosci/core",
  "version": "0.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./plural": {
      "types": "./dist/plural.d.ts",
      "default": "./dist/plural.js"
    },
    "./today": {
      "types": "./dist/today.d.ts",
      "default": "./dist/today.js"
    },
    "./overlay": {
      "types": "./dist/overlay.d.ts",
      "default": "./dist/overlay.js"
    },
    "./balance": {
      "types": "./dist/balance.d.ts",
      "default": "./dist/balance.js"
    },
    "./period": {
      "types": "./dist/period.d.ts",
      "default": "./dist/period.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
