# Skopiuj do .env.prod i uzupełnij. NIE commituj .env.prod (jest w .gitignore).
NODE_ENV=production
# Hasło bazy (musi pasować w DATABASE_URL poniżej):
POSTGRES_PASSWORD=zmien-mnie-na-silne-haslo
# Host bazy = nazwa serwisu z compose (db).
#
# Aplikacja pracuje na roli ograniczonej, która NIE może modyfikować ani kasować dziennika
# audytu — dzięki temu jego niemodyfikowalność jest właściwością bazy, a nie obietnicą kodu.
# Rolę zakłada się raz, po pierwszych migracjach: patrz scripts/db-appuser.sql i README.
DATABASE_URL=postgresql://nieobecnosci_app:zmien-mnie-haslo-aplikacji@db:5432/nieobecnosci?schema=public
# Poświadczenie właściciela schematu — używane WYŁĄCZNIE do `prisma migrate deploy` przy starcie.
# Pominięcie tej zmiennej cofa rozdzielenie ról: migracje i aplikacja idą wtedy na DATABASE_URL.
MIGRATE_DATABASE_URL=postgresql://nieobecnosci:zmien-mnie-na-silne-haslo@db:5432/nieobecnosci?schema=public
# Długi losowy sekret (np. `openssl rand -hex 32`). Brak w produkcji = API NIE wstanie (fail-fast).
JWT_SECRET=wygeneruj-dlugi-losowy-sekret
# Automatyczne przypomnienia o zaległym urlopie + retencja (cron 02:00):
SCHEDULER_ENABLED=true
# Domena z automatycznym TLS (ACME) albo wewn. host (Caddy: certyfikat internal):
SITE_ADDRESS=absencje.firma.example
# Poczta wychodząca (przypomnienia, powiadomienia liderów):
SMTP_ENABLED=true
SMTP_HOST=smtp.firma.example
SMTP_PORT=25
SMTP_FROM=nieobecnosci@firma.example
